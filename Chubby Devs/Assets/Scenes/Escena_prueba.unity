  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 234557223}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c988f5966cf54984582892729ef1724a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1632638605}
  dialogueText: {fileID: 74222587}
  dialogueLines:
  - "Player: \n\nBuenas tardes, se\xF1or. Mi nombre es Mendoza. Busco a mis amigos.
    Nos pusimos de acuerdo para encontrarnos ac\xE1 pero no me responden el celular.
    De casualidad sabr\xE1 algo?"
  - "Hombre misterioso: \n\nLlamame Yuyo, pibe. A tus amigos yo los habia visto.
    Yo les adverti... No me hicieron caso... Fueron ellos... \n"
  - "Mendoza: \n\nComo? De que habla? Quienes ellos?"
  - "Yuyo: \n\nYo les dije pibe... Se los llevaron ellos... Se quedaron en el hotel...
    No trates de encontrarlos... O tambien te van a llevar a vos... Aunque sea salvate
    vos..."
  - "Mendoza:\n\nPero qu\xE9 le pasa? Viejo loco."
  - 'Yuyo:


    La luz... La luz te va a salvar... Los aleja... Usa la luz...'
  playerMovementScript: {fileID: 817032545}
